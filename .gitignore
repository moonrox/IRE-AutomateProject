.coverage
htmlcov/

# VS Code workspace state (keep extensions.json and tasks.json)
.vscode/*.log

# OS
Thumbs.db
.DS_Store

# ── Skills framework (from ire-python-template) ──────────────────────────────
.env.*

# Project tracker database (runtime data - not committed)
.tracker/

